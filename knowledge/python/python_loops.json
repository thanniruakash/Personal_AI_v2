{
  "subject": "Python",
  "section": "Loops",
  "topics": [
    {
      "topic": "for Loop",
      "definition": "A for loop is used to iterate over a sequence.",
      "syntax": "for i in range(5):\n    print(i)",
      "example": "for i in range(1,6):\n    print(i)",
      "output": "1\n2\n3\n4\n5",
      "tips": [
        "Best when number of iterations is known."
      ]
    },
    {
      "topic": "while Loop",
      "definition": "A while loop repeats as long as a condition is True.",
      "syntax": "while condition:\n    statements",
      "example": "i=1\nwhile i<=3:\n    print(i)\n    i+=1",
      "output": "1\n2\n3",
      "tips": [
        "Update the loop variable to avoid an infinite loop."
      ]
    },
    {
      "topic": "Nested Loops",
      "definition": "A loop inside another loop.",
      "syntax": "for i in range(2):\n    for j in range(2):\n        print(i,j)",
      "example": "2 \u00d7 2 nested loop",
      "output": "(0,0) (0,1) (1,0) (1,1)",
      "tips": [
        "Useful for patterns and matrices."
      ]
    },
    {
      "topic": "break",
      "definition": "Terminates the loop immediately.",
      "syntax": "break",
      "example": "for i in range(5):\n    if i==3:\n        break",
      "output": "Loop stops at 3",
      "tips": [
        "Used to exit a loop early."
      ]
    },
    {
      "topic": "continue",
      "definition": "Skips the current iteration and continues with the next.",
      "syntax": "continue",
      "example": "for i in range(5):\n    if i==2:\n        continue\n    print(i)",
      "output": "0\n1\n3\n4",
      "tips": [
        "Useful for skipping specific values."
      ]
    },
    {
      "topic": "pass",
      "definition": "A placeholder statement that does nothing.",
      "syntax": "pass",
      "example": "for i in range(3):\n    pass",
      "output": "No output",
      "tips": [
        "Used when code will be added later."
      ]
    },
    {
      "topic": "range()",
      "definition": "Generates a sequence of numbers.",
      "syntax": "range(start, stop, step)",
      "example": "list(range(1,6))",
      "output": "[1, 2, 3, 4, 5]",
      "tips": [
        "Commonly used with for loops."
      ]
    }
  ]
}