{
  "subject": "C Programming",
  "section": "Pointers",
  "topics": [
    {
      "topic": "What is a Pointer?",
      "definition": "A pointer is a variable that stores the memory address of another variable.",
      "syntax": "int *ptr;",
      "example": "int a=10; int *ptr=&a;",
      "output": "Pointer stores address of a",
      "tips": [
        "Pointers improve memory efficiency."
      ]
    },
    {
      "topic": "Pointer Declaration",
      "definition": "A pointer is declared using the * symbol.",
      "syntax": "data_type *pointer_name;",
      "example": "float *p;",
      "output": "Pointer declared",
      "tips": [
        "Pointer type should match the data type."
      ]
    },
    {
      "topic": "Pointer Initialization",
      "definition": "A pointer is initialized with the address of a variable.",
      "syntax": "ptr = &a;",
      "example": "int a=5; int *ptr=&a;",
      "output": "Pointer initialized",
      "tips": [
        "Initialize pointers before using them."
      ]
    },
    {
      "topic": "Dereference Operator (*)",
      "definition": "The * operator accesses the value stored at the pointer's address.",
      "syntax": "*ptr",
      "example": "printf(\"%d\", *ptr);",
      "output": "10",
      "tips": [
        "Dereferencing retrieves the stored value."
      ]
    },
    {
      "topic": "Address Operator (&)",
      "definition": "The & operator returns the memory address of a variable.",
      "syntax": "&variable",
      "example": "printf(\"%p\", &a);",
      "output": "Memory address",
      "tips": [
        "Used to initialize pointers."
      ]
    },
    {
      "topic": "Pointer Arithmetic",
      "definition": "Pointer arithmetic allows moving through memory locations.",
      "syntax": "ptr++",
      "example": "ptr = ptr + 1;",
      "output": "Pointer moves to next element",
      "tips": [
        "Commonly used with arrays."
      ]
    },
    {
      "topic": "Pointers and Arrays",
      "definition": "Array names behave like pointers to the first element.",
      "syntax": "int arr[5];",
      "example": "*(arr+2)",
      "output": "Third array element",
      "tips": [
        "Array indexing and pointer arithmetic are related."
      ]
    },
    {
      "topic": "Pointers to Functions",
      "definition": "Pointers can be passed to functions or point to functions.",
      "syntax": "void fun(int *p);",
      "example": "fun(&a);",
      "output": "Function receives address",
      "tips": [
        "Useful for modifying variables in functions."
      ]
    },
    {
      "topic": "Dynamic Memory Allocation",
      "definition": "Memory can be allocated during runtime using malloc(), calloc(), realloc() and released with free().",
      "syntax": "ptr = (int*)malloc(sizeof(int));",
      "example": "free(ptr);",
      "output": "Memory allocated and released",
      "tips": [
        "Always free dynamically allocated memory."
      ]
    }
  ]
}