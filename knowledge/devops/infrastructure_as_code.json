      "definition": "Infrastructure as Code manages infrastructure using configuration files instead of manual setup.",
      "syntax": "Code \u2192 Provision",
      "example": "Provisioning cloud servers",
      "output": "Infrastructure created",
      "tips": [
        "Store IaC files in version control."
      ]
    },
    {
