      ]
    },
    {
      "topic": "Agent",
      "definition": "The agent is the learner that takes actions.",
      "syntax": "State \u2192 Action",
      "example": "Game bot",
      "output": "Selected action",
      "tips": [
        "The goal is to maximize reward."
      ]
    },
    {
      "topic": "Environment",
      "definition": "The environment is everything the agent interacts with.",
      "syntax": "Agent \u2194 Environment",
      "example": "Chess board",
      "output": "New state",
      "tips": [
        "Environment provides feedback."
      ]
    },
    {
      "topic": "State",
      "definition": "A state represents the current situation of the environment.",
      "syntax": "Environment \u2192 State",
      "example": "Robot position",
      "output": "Current state",
      "tips": [
        "States should capture relevant information."
      ]
    },
    {
      "topic": "Action",
      "definition": "An action is a decision taken by the agent.",
