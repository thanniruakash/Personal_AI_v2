  "section": "SLAM",
  "topics": [
    {
      "topic": "What is SLAM?",
      "definition": "SLAM (Simultaneous Localization and Mapping) enables a robot to build a map while estimating its own location.",
      "syntax": "Sensors \u2192 Map + Position",
      "example": "Autonomous robot exploring a building",
      "output": "Map and robot pose",
      "tips": [
        "Accurate sensors improve SLAM performance."
      ]
    },
    {
      "topic": "Mapping",
      "definition": "Mapping creates a representation of the robot's surroundings.",
      "syntax": "Sensor Data \u2192 Map",
      "example": "Indoor floor map",
      "output": "Environment map",
      "tips": [
        "Update maps continuously."
      ]
    },
    {
      "topic": "Localization",
      "definition": "Localization estimates the robot's position within the generated map.",
      "syntax": "Map + Sensors \u2192 Position",
      "example": "Warehouse robot",
      "output": "Robot location",
      "tips": [
        "Combine multiple sensors for robustness."
      ]
    },
    {
      "topic": "Visual SLAM",
      "definition": "Visual SLAM uses cameras to perform mapping and localization.",
      "syntax": "Camera \u2192 Features \u2192 Map",
      "example": "Drone navigation",
      "output": "Visual map",
      "tips": [
        "Good lighting improves accuracy."
      ]
    },
    {
      "topic": "LiDAR SLAM",
