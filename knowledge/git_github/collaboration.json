      "example": "feature-login branch",
      "output": "Feature isolated",
      "tips": [
        "Keep feature branches focused on one task."
      ]
    },
    {
      "topic": "Code Reviews",
      "definition": "Team members review code before it is merged.",
      "syntax": "Pull Request \u2192 Review",
      "example": "Reviewing authentication code",
      "output": "Code approved",
      "tips": [
        "Provide constructive feedback."
      ]
    },
    {
      "topic": "Pull Request Workflow",
      "definition": "A pull request proposes changes for review and merging.",
      "syntax": "Branch \u2192 PR \u2192 Merge",
      "example": "Merge feature-search into main",
      "output": "Changes integrated",
      "tips": [
        "Describe changes clearly."
      ]
    },
    {
      "topic": "Commit Message Conventions",
      "definition": "Clear commit messages make project history easier to understand.",
      "syntax": "type: short description",
      "example": "fix: resolve login bug",
      "output": "Readable history",
      "tips": [
        "Keep messages short and meaningful."
      ]
    },
    {
      "topic": "Issue Tracking",
