      "example": "Sprint task board",
      "output": "Project progress tracked",
      "tips": [
        "Update task status regularly."
      ]
    },
    {
      "topic": "Collaboration Best Practices",
      "definition": "Communicate well, review code, document changes and merge frequently.",
      "syntax": "Plan \u2192 Develop \u2192 Review \u2192 Merge",
      "example": "Open-source team workflow",
      "output": "Efficient collaboration",
      "tips": [
