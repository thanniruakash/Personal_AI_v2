      "syntax": "/tmp",
      "example": "Temporary installer files",
      "output": "Temporary data stored",
      "tips": [
        "Contents may be cleared automatically."
      ]
    },
    {
      "topic": "/proc",
      "definition": "A virtual filesystem containing process and kernel information.",
