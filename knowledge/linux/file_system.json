  "section": "File System",
  "topics": [
    {
      "topic": "Linux Directory Structure",
      "definition": "Linux organizes files in a hierarchical tree starting from the root directory.",
      "syntax": "/",
      "example": "/home/user",
      "output": "Structured file system",
      "tips": [
        "Learn the standard directory layout."
      ]
    },
    {
      "topic": "Root Directory (/)",
      "definition": "The root directory is the top-level directory containing all other directories.",
      "syntax": "/",
      "example": "/etc",
      "output": "Root accessed",
      "tips": [
        "All paths originate here."
      ]
    },
    {
      "topic": "Home Directory",
      "definition": "The home directory stores personal files and user settings.",
      "syntax": "/home/username",
      "example": "/home/akash",
      "output": "User files stored",
      "tips": [
        "Keep personal work here."
      ]
    },
    {
      "topic": "/bin",
      "definition": "Contains essential user command binaries.",
      "syntax": "/bin",
      "example": "ls, cp",
      "output": "Commands available",
      "tips": [
        "Critical for basic system operation."
      ]
    },
    {
      "topic": "/etc",
      "definition": "Stores system-wide configuration files.",
      "syntax": "/etc",
      "example": "/etc/passwd",
      "output": "Configuration accessed",
      "tips": [
        "Edit carefully."
      ]
    },
    {
      "topic": "/var",
      "definition": "Stores variable data such as logs, cache and mail.",
      "syntax": "/var",
      "example": "/var/log",
      "output": "Variable data stored",
      "tips": [
        "Check logs for troubleshooting."
      ]
    },
    {
      "topic": "/tmp",
